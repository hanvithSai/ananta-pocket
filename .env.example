# Environment variables for local development
# Copy this file to .env and replace the placeholder values with your real credentials.

# MongoDB Atlas connection string used by backend/config/db.js
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?appName=<app-name>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster0-host>/products?appName=Cluster0
